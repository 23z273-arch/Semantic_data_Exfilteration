# ===================================================
# PS-5.3 Semantic Data Exfiltration Detector
# Environment Configuration
# ===================================================

# ---- LLM / Embedding Provider ----
# Leave blank to use local sentence-transformers (no API key needed)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=

# Embedding provider: "openai" or "local"
EMBEDDING_PROVIDER=openai

# LLM provider for factual verification: "openai", "anthropic", or "mock"
LLM_PROVIDER=openai

# ---- Detection Thresholds (tunable) ----
STAGE2_TRIGGER_THRESHOLD=0.55
BLOCK_THRESHOLD=0.75
WARN_THRESHOLD=0.50

# ---- Weights ----
EMBEDDING_WEIGHT=0.30
FACTUAL_WEIGHT=0.70

# ---- Session ----
SESSION_WINDOW_SIZE=10
SESSION_BLOCK_THRESHOLD=0.65
SESSION_ESCALATION_MULTIPLIER=1.25

# ---- Server ----
FRONTEND_URL=http://localhost:3000
